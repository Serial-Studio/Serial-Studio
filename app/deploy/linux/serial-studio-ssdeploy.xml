<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
	<mime-type type="application/x-serial-studio-deployment">
		<comment>Serial Studio Deployment Package</comment>
		<glob pattern="*.ssdeploy"/>
		<magic priority="50">
			<match type="string" value="SSDEPLOY" offset="0"/>
		</magic>
		<icon name="serial-studio-pro"/>
	</mime-type>
</mime-info>
