  "controlScriptCode": "/**\n * Sparkplug B Edge Node Simulator - Control Loop\n *\n * Launches the bundled Python edge-node publisher (sparkplug_edge_node.py) automatically just\n * before the connection opens (via onConnect), so the example works without running anything by\n * hand. The helper process is stopped by Serial Studio when the device is disconnected, when the\n * project changes, or when the app quits.\n *\n * The interpreter is resolved cross-platform: \"python3\" is tried first (Linux/macOS), falling\n * back to \"python\" (typical on Windows).\n *\n * This helper is the edge node, not the broker: an MQTT broker (Mosquitto is the usual choice)\n * must already be running on localhost:1883, since the edge node connects to it to publish.\n */\n\nvar helperPid = -1;\n\nfunction startHelper() {\n  var dir = system.projectDir();\n  if (!dir.ok)\n    return;\n\n  var script = dir.result.directory + \"/sparkplug_edge_node.py\";\n\n  var r = system.exec(\"python3\", { args: [\"-u\", script, \"--host\", \"127.0.0.1\", \"--port\", \"1883\"], workingDir: dir.result.directory });\n  if (!r.ok)\n    r = system.exec(\"python\", { args: [\"-u\", script, \"--host\", \"127.0.0.1\", \"--port\", \"1883\"], workingDir: dir.result.directory });\n\n  if (r.ok)\n    helperPid = r.result.processId;\n}\n\nfunction onConnect() {\n  startHelper();\n}\n\nfunction setup() {}\n\nfunction loop() {\n  delay(1000);\n}\n",
