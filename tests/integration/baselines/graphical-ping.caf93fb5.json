  "controlScriptCode": "/**\n * Graphical Ping - Control Loop\n *\n * Launches the bundled Python helper (gping.py) when the connection opens.\n * The helper runs the operating system's `ping` command against `host` and\n * streams the round-trip time over UDP. Serial Studio stops the helper when\n * the device is disconnected, when the project changes, or when the app quits.\n *\n * Edit `host` and `intervalSeconds` below, then reconnect.\n *\n * The interpreter is resolved cross-platform: \"python3\" is tried first\n * (Linux/macOS), falling back to \"python\" (typical on Windows).\n */\n\nvar host = \"google.com\";\nvar intervalSeconds = 0.2;\n\nvar helperPid = -1;\n\nfunction startHelper() {\n  var dir = system.projectDir();\n  if (!dir.ok)\n    return;\n\n  var script = dir.result.directory + \"/gping.py\";\n  var args = [\"-u\", script, host, \"--interval\", String(intervalSeconds)];\n\n  var r = system.exec(\"python3\", { args: args, workingDir: dir.result.directory });\n  if (!r.ok)\n    r = system.exec(\"python\", { args: args, workingDir: dir.result.directory });\n\n  if (r.ok)\n    helperPid = r.result.processId;\n}\n\nfunction setup() {\n  startHelper();\n}\n\nfunction loop() {\n  delay(1000);\n}\n",
