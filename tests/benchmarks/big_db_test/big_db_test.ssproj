{
    "actions": [
    ],
    "changeDrivenTransforms": true,
    "controlScriptCode": "/**\n * BigDB Watchdog Control Script\n *\n * Monitors frame arrival. If no frame is seen for WATCHDOG_TIMEOUT_MS the\n * whole fleet is marked as a communication loss and every channel on every\n * board (all three types, ids 1..6) is invalidated. Normal arrival clears it.\n *\n * Launched with --define BIGDB_TOUR=1 (the load scripts do this for a\n * windowed run) the script also walks the main window through every\n * workspace, one per WORKSPACE_DWELL_MS, so each widget type is built and\n * painted during a profile-training run. Every step is logged as\n * \"[BigDB] workspace i/n: title\"; the load scripts count those lines to\n * prove the dashboard really rendered. Without the define the window stays\n * where the operator put it.\n */\n\nconst WATCHDOG_TIMEOUT_MS = 1000;\nconst WORKSPACE_DWELL_MS = 500;\nconst ALARM_TITLE = \"CAN Bus Error\";\nconst BOARD_COUNT = 6;\nconst TYPES = [\n  { name: \"TA\", valkey: \"resistance\", extra: [] },\n  { name: \"TB\", valkey: \"val\",        extra: [\"mode\"] },\n  { name: \"TC\", valkey: \"temp\",       extra: [\"type\"] },\n];\n\nlet lastFrameTime = 0;\nlet watchdogTriggered = false;\n\nlet tourEnabled = false;\nlet tourCursor = 0;\nlet nextTourMs = 0;\n\nfunction setup() {\n  const define = apiCall(\"system.getDefine\", { key: \"BIGDB_TOUR\" });\n  tourEnabled = define.ok && define.result && define.result.defined\n                && define.result.value !== \"0\";\n\n  dashboardTick();\n}\n\nfunction markCommLoss() {\n  watchdogTriggered = true;\n\n  for (let t = 0; t < TYPES.length; t++) {\n    const ty = TYPES[t];\n    for (let brd = 1; brd <= BOARD_COUNT; brd++) {\n      const board = \"DAQ/\" + ty.name + \"/BRD-\" + brd;\n      tableSet(board, \"boot_reset_cause\", 0x01);\n      tableSet(board, \"boot_selftest\", 0xFF);\n\n      for (let ch = 1; ch <= 8; ch++) {\n        tableSet(board, \"ch\" + ch + \"_\" + ty.valkey, 0xFFFF);\n        tableSet(board, \"ch\" + ch + \"_diag\", 0xFF);\n        for (let e = 0; e < ty.extra.length; e++)\n          tableSet(board, \"ch\" + ch + \"_\" + ty.extra[e], 0x00);\n      }\n    }\n  }\n\n  refreshDashboard();\n  dashboardTick();\n}\n\nfunction clearCommLoss() {\n  watchdogTriggered = false;\n  notifyClear(ALARM_TITLE, \"CAN communications restored\");\n  notifyInfo(\"Information\", \"CAN communications restored\");\n}\n\n/**\n * Shows the next workspace in the main window. Before the dashboard is up\n * (and in a headless run, always) the list command answers with no session,\n * so the step is retried on the next dwell.\n */\nfunction tourWorkspaces() {\n  const now = Date.now();\n  if (!tourEnabled || now < nextTourMs)\n    return;\n\n  nextTourMs = now + WORKSPACE_DWELL_MS;\n\n  const list = apiCall(\"ui.window.listGroups\");\n  if (!list.ok || !list.result || !list.result.groups)\n    return;\n\n  const groups = list.result.groups;\n  if (groups.length === 0)\n    return;\n\n  if (tourCursor >= groups.length)\n    tourCursor = 0;\n\n  const group = groups[tourCursor];\n  if (!apiCall(\"ui.window.setActiveGroup\", { groupId: group.id }).ok)\n    return;\n\n  tourCursor++;\n  console.log(\"[BigDB] workspace \" + tourCursor + \"/\" + groups.length + \": \" + group.text);\n}\n\nfunction loop() {\n  const frame = newFrame();\n\n  if (frame) {\n    lastFrameTime = Date.now();\n\n    if (watchdogTriggered)\n      clearCommLoss();\n\n    dashboardTick();\n  }\n  else if (lastFrameTime !== 0) {\n    const elapsed = Date.now() - lastFrameTime;\n    if (elapsed > WATCHDOG_TIMEOUT_MS && !watchdogTriggered) {\n      notifyCritical(ALARM_TITLE, \"No CAN frames received for \" + elapsed + \" milliseconds\");\n      markCommLoss();\n    }\n  }\n\n  tourWorkspaces();\n  delay(20);\n}\n",
    "customizeWorkspaces": true,
    "diagramCollapse": {
        "grp:66": true,
        "grp:67": true
    },
