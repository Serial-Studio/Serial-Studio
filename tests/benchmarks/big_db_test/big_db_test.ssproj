    "nextUniqueId": 801,
    "plotTimeRange": 10,
    "pointCount": 1000,
    "schemaVersion": 3,
    "sources": [
        {
            "busType": 1,
            "checksum": "",
            "checksumAlgorithm": "",
            "connection": {
                "address": "localhost",
                "socketTypeIndex": 1,
                "udpLocalPort": 8080,
                "udpMulticast": false,
                "udpRemotePort": 8080
            },
            "decoder": 3,
            "decoderMethod": 3,
            "frameDetection": 2,
            "frameEnd": "\n",
            "frameParserCode": "--------------------------------------------------------------------------\n-- BigDB unified parser - decodes all three board types onto one bus.\n--------------------------------------------------------------------------\n--\n-- 11-bit standard CAN ID:\n--   bits [9:8] board type  (1 = TA, 2 = TB, 3 = TC)\n--   bits [7:3] board id    (1..6)\n--   bits [2:0] reading id  (0/1 data, 2 diag, 5 cal[TB], 6 info, 7 boot)\n--\n-- Readings land in a per-board table named \"DAQ/<TYPE>/BRD-<id>\" (for\n-- example \"DAQ/TA/BRD-3\"), so the same board id across different types\n-- never collides. All output goes straight to the tables; parse() always\n-- returns an empty dataset list.\n--\n-- Hot path: each board's register names are resolved to table handles\n-- once, on the first frame for that board, and then read and written via\n-- tableGetH/tableSetH, so no register-name string is built or hashed per\n-- frame.\n--------------------------------------------------------------------------\n\nlocal floor  = math.floor\nlocal format = string.format\nlocal th, tg, ts = tableHandle, tableGetH, tableSetH\n\nlocal BUNDLES    = {}\nlocal TYPE_NAMES = { [1] = \"TA\", [2] = \"TB\", [3] = \"TC\" }\nlocal VAL_KEY    = { [1] = \"resistance\", [2] = \"val\", [3] = \"temp\" }\n\n--------------------------------------------------------------------------\n-- byte(frame, i) -> value of the zero-based byte i (frames are 1-indexed)\n--------------------------------------------------------------------------\n\nlocal function byte(frame, i)\n  return frame[i + 1]\nend\n\n--------------------------------------------------------------------------\n-- format_utc(epoch) -> \"YYYY-MM-DD HH:MM UTC\"\n--   Converts a Unix epoch (UTC seconds) to a fixed-width UTC timestamp\n--   with no dependency on the os library, through the days-to-civil\n--   algorithm for epoch >= 0.\n--------------------------------------------------------------------------\n\nlocal function format_utc(epoch)\n  local days = floor(epoch / 86400)\n  local secs = epoch - days * 86400\n\n  local z   = days + 719468\n  local era = floor(z / 146097)\n  local doe = z - era * 146097\n  local yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365)\n  local doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100))\n  local mp  = floor((5 * doy + 2) / 153)\n  local day = doy - floor((153 * mp + 2) / 5) + 1\n  local month = mp < 10 and mp + 3 or mp - 9\n  local year  = yoe + era * 400 + (month <= 2 and 1 or 0)\n\n  return format(\"%04d-%02d-%02d %02d:%02d UTC\", year, month, day,\n                floor(secs / 3600), floor((secs % 3600) / 60))\nend\n\n--------------------------------------------------------------------------\n-- make_bundle(board_type, tbl, valkey) -> handle bundle for one board\n--------------------------------------------------------------------------\n\nlocal function make_bundle(board_type, tbl, valkey)\n  local b = { val = {}, diag = {}, mode = {} }\n  for ch = 1, 8 do\n    b.val[ch]  = th(tbl, \"ch\" .. ch .. \"_\" .. valkey)\n    b.diag[ch] = th(tbl, \"ch\" .. ch .. \"_diag\")\n  end\n\n  b.boot_reset = th(tbl, \"boot_reset_cause\")\n  b.boot_self  = th(tbl, \"boot_selftest\")\n  b.rx         = th(tbl, \"rx_count\")\n\n  if board_type == 2 then\n    for ch = 1, 8 do\n      b.mode[ch] = th(tbl, \"ch\" .. ch .. \"_mode\")\n    end\n\n    b.cal_accepted = th(tbl, \"cal_accepted\")\n    b.cal_stored   = th(tbl, \"cal_stored\")\n    b.cal_epoch    = th(tbl, \"cal_epoch\")\n    b.cal_time     = th(tbl, \"cal_time\")\n  end\n\n  if board_type == 3 then\n    for ch = 1, 8 do\n      b.mode[ch] = th(tbl, \"ch\" .. ch .. \"_type\")\n    end\n  end\n\n  return b\nend\n\nlocal function bundle_for(board_type, board_id)\n  local key = board_type * 32 + board_id\n  local b = BUNDLES[key]\n  if not b then\n    local tbl = \"DAQ/\" .. TYPE_NAMES[board_type] .. \"/BRD-\" .. board_id\n    b = make_bundle(board_type, tbl, VAL_KEY[board_type])\n    BUNDLES[key] = b\n  end\n\n  return b\nend\n\n--------------------------------------------------------------------------\n-- u16_be(frame, byte_offset, n) -> big-endian uint16 of the payload, or\n-- the invalid sentinel when the frame is too short to hold it\n--------------------------------------------------------------------------\n\nlocal function u16_be(frame, byte_offset, n)\n  local i = 3 + byte_offset\n  if i + 1 > n - 1 then\n    return 0xFFFF\n  end\n\n  return byte(frame, i) * 256 + byte(frame, i + 1)\nend\n\n--------------------------------------------------------------------------\n-- set_block(b, base_ch, frame, n)\n--   Publishes one four-channel data block (channels base_ch..base_ch+3):\n--   writes each channel's value and clears its diag on a valid reading.\n--------------------------------------------------------------------------\n\nlocal function set_block(b, base_ch, frame, n)\n  for i = 0, 3 do\n    local v = u16_be(frame, i * 2, n)\n    local ch = base_ch + i\n\n    ts(b.val[ch], v)\n    if v < 0xFFFD then\n      ts(b.diag[ch], 0x00)\n    end\n  end\nend\n\n--------------------------------------------------------------------------\n-- set_calibration(b, frame, n) - TB aux frame: accepted mask, stored flag\n-- and the host epoch of the calibration run\n--------------------------------------------------------------------------\n\nlocal function set_calibration(b, frame, n)\n  ts(b.cal_accepted, byte(frame, 3))\n  ts(b.cal_stored, byte(frame, 4))\n  if n < 9 then\n    return\n  end\n\n  local cal_epoch = byte(frame, 5) * 16777216\n                  + byte(frame, 6) * 65536\n                  + byte(frame, 7) * 256\n                  + byte(frame, 8)\n\n  ts(b.cal_epoch, cal_epoch)\n  if cal_epoch > 0 then\n    ts(b.cal_time, format_utc(cal_epoch))\n  else\n    ts(b.cal_time, \"\")\n  end\nend\n\n--------------------------------------------------------------------------\n-- parse(frame) -> {}\n--------------------------------------------------------------------------\n\nfunction parse(frame)\n  local n = frame and #frame or 0\n  if n < 3 then\n    if io.getStatus().isConnected then\n      console.log(\"[BigDB] ERROR: Frame too short: \" .. n .. \" bytes\")\n    end\n\n    return {}\n  end\n\n  local can_id = byte(frame, 0) * 256 + byte(frame, 1)\n  if (can_id % 0x800) >= 0x400 then\n    return {}\n  end\n\n  local board_type = floor(can_id / 256) % 4\n  local board_id   = floor(can_id / 8) % 32\n  local reading_id = can_id % 8\n\n  if not TYPE_NAMES[board_type] then\n    console.log(\"[BigDB] SKIP: unknown board_type=\" .. board_type)\n    return {}\n  end\n\n  local b = bundle_for(board_type, board_id)\n  ts(b.rx, (tg(b.rx) or 0) + 1)\n\n  if reading_id == 0 then\n    if n < 11 then return {} end\n    set_block(b, 1, frame, n)\n\n  elseif reading_id == 1 then\n    if n < 11 then return {} end\n    set_block(b, 5, frame, n)\n\n  elseif reading_id == 2 then\n    if n < 11 then return {} end\n    for ch = 1, 8 do\n      local fault = byte(frame, 3 + (ch - 1))\n      ts(b.diag[ch], fault)\n      if fault ~= 0x00 and fault ~= 0xA6 and fault ~= 0xA7 then\n        ts(b.val[ch], 0xFFFF)\n      end\n    end\n\n  elseif reading_id == 5 and board_type == 2 then\n    if n < 5 then return {} end\n    set_calibration(b, frame, n)\n\n  elseif reading_id == 6 then\n    if n < 11 then return {} end\n    if board_type == 2 or board_type == 3 then\n      for ch = 1, 8 do\n        ts(b.mode[ch], byte(frame, 3 + (ch - 1)))\n      end\n    end\n\n  elseif reading_id == 7 then\n    if n < 5 then return {} end\n    ts(b.boot_reset, byte(frame, 3))\n    ts(b.boot_self, byte(frame, 4))\n  end\n\n  return {}\nend\n",
            "frameParserLanguage": 1,
            "frameParserParams": {
                "quoteChar": "",
                "separator": ",",
                "skipEmpty": false,
                "trimFields": false
            },
