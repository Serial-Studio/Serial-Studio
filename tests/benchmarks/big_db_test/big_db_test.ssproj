    "title": "BigDB",
    "transformLibrary": "-- BigDB shared transform library.\n--\n-- Serial Studio evaluates this chunk once into the global scope of every Lua transform engine\n-- before the dataset transforms compile, so every global defined here is callable from any\n-- transform.\n--\n-- Every public function is a factory: it receives the dataset's `params` table and returns the\n-- transform closure for that dataset, holding that dataset's own state (table handles, filter\n-- state, calibration). A dataset's transformCode is then one line, for example\n--     transform = RtdTemperature(params)\n-- with transformParams {\"table\": \"DAQ/TA/BRD-1\", \"register\": \"ch1_resistance\", \"cal\": \"ta1_ch1\"}.\n--\n-- Sentinels: 0xFFFF invalid, 0xFFFE over range, 0xFFFD under range; 0x0000 is a legal reading.\n-- Table handles are resolved on the first call, never at compile time: the table store is\n-- rebuilt on connect, after the transforms compile.\n\nlocal sqrt = math.sqrt\nlocal huge = math.huge\nlocal sformat = string.format\nlocal schar = string.char\nlocal tconcat = table.concat\nlocal band = bit32.band\nlocal lshift = bit32.lshift\n\nlocal CONSTANTS = \"Config/Constants\"\nlocal CALIBRATION = \"Config/Calibration\"\n\nlocal INVALID = 0xFFFF\nlocal OVER    = 0xFFFE\nlocal UNDER   = 0xFFFD\n\n-- Per board family: the diagnostic byte vocabulary and the self-test strings.\nlocal FAMILY = {\n  ta = {\n    reject = \"Software Reject (rail/tear/config/warm-up)\",\n    faults = {\n      { 0x80, \"Open Sensor (high rail)\" },\n      { 0x40, \"Shorted Sensor (low rail)\" },\n      { 0x20, \"Reference High\" },\n      { 0x10, \"Reference Low\" },\n      { 0x08, \"Input Low\" },\n      { 0x04, \"Over/Undervoltage\" },\n    },\n    selftest_ok = \"All ADCs OK\",\n    selftest_fail = \"Sensor Failure\",\n  },\n  tb = {\n    reject = \"Software Reject (warm-up/CRC/config)\",\n    dead_loop = \"Open / Dead Loop\",\n    selftest_ok = \"ADC OK\",\n    selftest_fail = \"ADC Failure\",\n  },\n  tc = {\n    reject = \"Software Reject (warm-up/tear/config)\",\n    open_bit = 0x01,\n    open_text = \"Open Sensor\",\n    faults = {\n      { 0x02, \"Over/Undervoltage\" },\n      { 0x04, \"Signal Low Threshold\" },\n      { 0x08, \"Signal High Threshold\" },\n      { 0x10, \"Aux Low Threshold\" },\n      { 0x20, \"Aux High Threshold\" },\n      { 0x40, \"Signal Out of Range\" },\n      { 0x80, \"Aux Out of Range\" },\n    },\n    selftest_ok = \"All ADCs OK\",\n    selftest_fail = \"Sensor Failure\",\n  },\n}\n\nlocal RESET_CAUSES = {\n  { 0x80, \"Low Power\" },\n  { 0x40, \"Window Watchdog\" },\n  { 0x20, \"Watchdog Reset\" },\n  { 0x10, \"Software Reset\" },\n  { 0x08, \"Power-on Reset\" },\n  { 0x04, \"Reset Pin\" },\n  { 0x02, \"Config Reload\" },\n}\n\nlocal function family(p)\n  return FAMILY[p.family] or error(\"unknown board family: \" .. tostring(p.family))\nend\n\nlocal function constant(name, default)\n  return tableGetH(tableHandle(CONSTANTS, name)) or default\nend\n\nlocal function split(list)\n  local items = {}\n  for item in string.gmatch(list, \"[^,%s]+\") do\n    items[#items + 1] = item\n  end\n  return items\nend\n\n-- A live reading: a number that is neither NaN nor infinite. Text finals (Disconnected,\n-- Under Range) fail this.\nlocal function finite(value)\n  return type(value) == \"number\" and value == value and value > -huge and value < huge\nend\n\n-- Per-channel linear correction read from the calibration table on every call, so a value\n-- edited there applies without recompiling: <tag>_gain and <tag>_offset.\nlocal function Calibration(tag)\n  local gain_h\n  local offset_h\n\n  return function(reading)\n    if gain_h == nil then\n      gain_h = tableHandle(CALIBRATION, tag .. \"_gain\")\n      offset_h = tableHandle(CALIBRATION, tag .. \"_offset\")\n    end\n\n    return reading * (tableGetH(gain_h) or 1) + (tableGetH(offset_h) or 0)\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- TA boards: RTD resistance (centiohms) to degrees Fahrenheit\n-- params: table, register, cal\n-- ------------------------------------------------------------------------------------------\nfunction RtdTemperature(p)\n  local correct = Calibration(p.cal)\n  local handle\n  local R0, A, B, C\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, p.register)\n      R0 = constant(\"rtd_r0\", 100)\n      A = constant(\"rtd_a\", 3.9083e-3)\n      B = constant(\"rtd_b\", -5.775e-7)\n      C = constant(\"rtd_c\", -4.183e-12)\n    end\n\n    local centiohms = tableGetH(handle) or INVALID\n    if centiohms == INVALID then\n      return \"Disconnected\"\n    end\n\n    -- Limit sentinels clamp to the gauge/plot limits: the gauge pegs and the alarm bands\n    -- fire instead of the plot breaking on a string.\n    if centiohms == OVER then\n      return 1800\n    end\n\n    if centiohms == UNDER then\n      return -350\n    end\n\n    local R = correct(centiohms / 100)\n    local discriminant = A * A - 4 * B * (1 - (R / R0))\n    if discriminant < 0 then\n      return \"Disconnected\"\n    end\n\n    local tempC = (-A + sqrt(discriminant)) / (2 * B)\n\n    -- Sub-zero (R < R0): the quadratic is only exact for T >= 0, so refine on the full\n    -- four-term curve with a few Newton steps.\n    if R < R0 then\n      for _ = 1, 4 do\n        local t2 = tempC * tempC\n        local f = R0 * (1 + A * tempC + B * t2 + C * (tempC - 100) * t2 * tempC) - R\n        local df = R0 * (A + 2 * B * tempC + 4 * C * t2 * tempC - 300 * C * t2)\n        tempC = tempC - f / df\n      end\n    end\n\n    return tempC * 9 / 5 + 32\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- TC boards: thermocouple reading to degrees Fahrenheit. Device encoding: raw = (degC + 270)\n-- * 16; the frontend already linearizes and compensates, so this is scaling.\n-- params: table, register, cal\n-- ------------------------------------------------------------------------------------------\nfunction ThermocoupleTemperature(p)\n  local correct = Calibration(p.cal)\n  local handle\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, p.register)\n    end\n\n    local raw = tableGetH(handle) or INVALID\n    if raw == INVALID then\n      return \"Disconnected\"\n    end\n\n    if raw == OVER then\n      return 2600\n    end\n\n    if raw == UNDER then\n      return \"Under Range\"\n    end\n\n    local tempC = correct(raw / 16 - 270)\n    return (tempC * 9 / 5) + 32\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- TB boards: loop current in mA through an exponential moving average\n-- params: table, register, cal\n-- ------------------------------------------------------------------------------------------\nfunction LoopCurrent(p)\n  local correct = Calibration(p.cal)\n  local handle\n  local alpha\n  local ema = 0\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, p.register)\n      alpha = constant(\"loop_ema_alpha\", 0.6)\n    end\n\n    local raw = tableGetH(handle) or INVALID\n    if raw == INVALID then\n      return \"Disconnected\"\n    end\n\n    if raw == OVER then\n      return 26\n    end\n\n    if raw == UNDER then\n      return 0\n    end\n\n    ema = alpha * correct(raw / 1000) + (1 - alpha) * ema\n    return ema\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- 1 while the channel reports a reading, 0 while it carries the invalid sentinel\n-- params: table, register\n-- ------------------------------------------------------------------------------------------\nfunction SensorStatus(p)\n  local handle\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, p.register)\n    end\n\n    if (tableGetH(handle) or INVALID) == INVALID then\n      return 0\n    end\n\n    return 1\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- Diagnostic status byte to text, in the vocabulary of the board family\n-- params: family, table, register\n-- ------------------------------------------------------------------------------------------\nfunction Diagnostics(p)\n  local fam = family(p)\n  local handle\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, p.register)\n    end\n\n    local fault_byte = tableGetH(handle) or 0xFF\n    if fault_byte == 0x00 then\n      return \"Connected\"\n    end\n\n    if fault_byte == 0xA5 then\n      return fam.reject\n    end\n\n    if fault_byte == 0xA6 then\n      return \"Above Device Limit\"\n    end\n\n    if fault_byte == 0xA7 then\n      return \"Below Device Limit\"\n    end\n\n    if fam.dead_loop and fault_byte == 0xA8 then\n      return fam.dead_loop\n    end\n\n    if fam.open_bit and band(fault_byte, fam.open_bit) ~= 0 then\n      return fam.open_text\n    end\n\n    -- A frontend fault-status byte is a bitmask: several bits can be set at once.\n    local faults = {}\n    if fam.faults then\n      for i = 1, #fam.faults do\n        if band(fault_byte, fam.faults[i][1]) ~= 0 then\n          faults[#faults + 1] = fam.faults[i][2]\n        end\n      end\n    end\n\n    if #faults == 0 then\n      return sformat(\"Fault 0x%02x\", fault_byte)\n    end\n\n    return tconcat(faults, \" + \")\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- Boot frame: reset cause bitmask to text\n-- params: table\n-- ------------------------------------------------------------------------------------------\nfunction ResetCause(p)\n  local handle\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, \"boot_reset_cause\")\n    end\n\n    local reset_cause = tableGetH(handle) or 0\n    if reset_cause == 0x00 then\n      return \"No Reset\"\n    end\n\n    local causes = {}\n    for i = 1, #RESET_CAUSES do\n      if band(reset_cause, RESET_CAUSES[i][1]) ~= 0 then\n        causes[#causes + 1] = RESET_CAUSES[i][2]\n      end\n    end\n\n    if #causes == 0 then\n      return sformat(\"Unknown 0x%02x\", reset_cause)\n    end\n\n    return tconcat(causes, \"+\")\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- Boot frame: self-test result to text\n-- params: family, table\n-- ------------------------------------------------------------------------------------------\nfunction SelfTest(p)\n  local fam = family(p)\n  local handle\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, \"boot_selftest\")\n    end\n\n    local selftest = tableGetH(handle) or 0\n    if selftest == 1 then\n      return fam.selftest_ok\n    end\n\n    if selftest == 0 then\n      return fam.selftest_fail\n    end\n\n    return sformat(\"Unknown (0x%02x)\", selftest)\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- TB boards: configured acquisition mode, broadcast as an ASCII letter\n-- params: table, register\n-- ------------------------------------------------------------------------------------------\nfunction LoopMode(p)\n  local handle\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, p.register)\n    end\n\n    local mode = tableGetH(handle) or 0\n    if mode == 0 then\n      return \"Not Reported / Disabled\"\n    end\n\n    if mode == 65 then\n      return \"Current Loop\"\n    end\n\n    if mode == 86 then\n      return \"Voltage Input\"\n    end\n\n    return sformat(\"Unknown (0x%02x)\", mode)\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- TC boards: configured sensor type, broadcast as an ASCII letter\n-- params: table, register\n-- ------------------------------------------------------------------------------------------\nfunction ThermocoupleType(p)\n  local handle\n\n  return function(_value)\n    if handle == nil then\n      handle = tableHandle(p.table, p.register)\n    end\n\n    local kind = tableGetH(handle) or 0\n    if kind == 0 then\n      return \"Not Reported\"\n    end\n\n    return \"Type \" .. schar(kind)\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- TB boards: which channels the last calibration run trimmed, and whether it was stored\n-- params: table\n-- ------------------------------------------------------------------------------------------\nfunction LastCalibration(p)\n  local accepted_h\n  local stored_h\n  local time_h\n\n  return function(_value)\n    if accepted_h == nil then\n      accepted_h = tableHandle(p.table, \"cal_accepted\")\n      stored_h = tableHandle(p.table, \"cal_stored\")\n      time_h = tableHandle(p.table, \"cal_time\")\n    end\n\n    local mask = tableGetH(accepted_h) or 256\n    if mask == 256 then\n      return \"None since boot\"\n    end\n\n    if mask == 0 then\n      return \"All channels rejected\"\n    end\n\n    -- Bitmask: bit n = channel n+1 trimmed.\n    local chans = {}\n    for ch = 0, 7 do\n      if band(mask, lshift(1, ch)) ~= 0 then\n        chans[#chans + 1] = tostring(ch + 1)\n      end\n    end\n\n    local suffix = ((tableGetH(stored_h) or 0) == 1) and \" (stored)\" or \" (NOT stored)\"\n    local when = tableGetH(time_h)\n    if type(when) == \"string\" and when ~= \"\" then\n      suffix = suffix .. \" @ \" .. when\n    end\n\n    return \"Ch \" .. tconcat(chans, \",\") .. suffix\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- Fleet tier: mean of the live finals among several datasets, read by alias\n-- params: sources (comma separated aliases), no_data\n-- ------------------------------------------------------------------------------------------\nfunction Average(p)\n  local sources = split(p.sources)\n  local no_data = p.no_data\n\n  return function(_value)\n    local sum = 0.0\n    local count = 0\n\n    for i = 1, #sources do\n      local reading = datasetGetFinal(sources[i])\n      if finite(reading) then\n        sum = sum + reading\n        count = count + 1\n      end\n    end\n\n    if count == 0 then\n      return no_data\n    end\n\n    return sum / count\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- Fleet tier: highest minus lowest live final among several datasets\n-- params: sources (comma separated aliases), no_data\n-- ------------------------------------------------------------------------------------------\nfunction Spread(p)\n  local sources = split(p.sources)\n  local no_data = p.no_data\n\n  return function(_value)\n    local low = huge\n    local high = -huge\n\n    for i = 1, #sources do\n      local reading = datasetGetFinal(sources[i])\n      if finite(reading) then\n        if reading < low then low = reading end\n        if reading > high then high = reading end\n      end\n    end\n\n    if high < low then\n      return no_data\n    end\n\n    return high - low\n  end\nend\n\n-- ------------------------------------------------------------------------------------------\n-- Vibration source: counts to engineering units\n-- params: gain, offset\n-- ------------------------------------------------------------------------------------------\nfunction Scale(p)\n  local gain = p.gain or 1\n  local offset = p.offset or 0\n\n  return function(value)\n    if type(value) ~= \"number\" then\n      return value\n    end\n\n    return value * gain + offset\n  end\nend\n",
