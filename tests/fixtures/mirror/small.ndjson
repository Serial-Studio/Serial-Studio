{"mirror":{"kind":"structure","wireVersion":1,"epoch":1,"layoutHash":"3af81b130b65f883","sourceIds":[0],"datasets":[[0,0],[0,1],[0,2],[0,10000],[0,10001],[0,10002]],"operationMode":0,"plotTimeRange":10.0,"frozen":false,"clock":{"domain":"monotonic-relative","originUnixMs":1753459200000},"project":{"actions":[],"changeDrivenTransforms":false,"controlScriptCode":"/**\n * Lorenz Attractor - Control Loop (self-contained simulation)\n *\n * The entire simulation now lives in this control script: there is no external\n * data generator. loop() advances the Lorenz system, writes x/y/z into the\n * \"Lorenz\" data table with tableSet(), then dashboardTick() forces the virtual\n * datasets (whose Lua transforms read the table) to render. The UDP source is a\n * dummy, kept only so a connection can be opened; its Lua frame parser just\n * returns {0} and no bytes are ever parsed.\n *\n * This doubles as a control-loop benchmark. The loop free-runs (the worker\n * re-arms it about every millisecond), so STEPS_PER_TICK integration steps run\n * per dashboard refresh; raise it to push raw integration throughput past the\n * refresh rate. Every STATS_EVERY steps the measured step rate is reported, so\n * you can see how fast and how steadily the control loop actually runs.\n *\n * Lorenz system (Edward Lorenz, 1963), classic chaotic parameters:\n *   dx/dt = sigma (y - x),  dy/dt = x (rho - z) - y,  dz/dt = x y - beta z\n * integrated with the Euler method at a fixed dt.\n */\n\n//------------------------------------------------------------------------------\n// Configuration & constants\n//------------------------------------------------------------------------------\n\n// Lorenz parameters and Euler integration step.\nconst SIGMA = 10.0;\nconst RHO   = 28.0;\nconst BETA  = 8.0 / 3.0;\nconst DT    = 0.01;\n\n// Integration steps advanced per loop() call. 1 keeps the trace smooth and the\n// step rate close to the loop rate; higher values trade refresh rate for raw\n// integration throughput.\nconst STEPS_PER_TICK = 1;\n\n// Report the measured step rate every this many steps (0 disables reporting).\nconst STATS_EVERY = 50000;\n\n// Data table the virtual datasets read through their transforms.\nconst TABLE = \"Lorenz\";\n\n//------------------------------------------------------------------------------\n// Mutable state\n//------------------------------------------------------------------------------\n\nlet x = 0.1, y = 0.0, z = 0.0;\nlet stepCount = 0;\nlet lastReportStep = 0;\nlet lastReportMs = 0;\n\n//------------------------------------------------------------------------------\n// Integration\n//------------------------------------------------------------------------------\n\n/**\n * @brief Advances the Lorenz state by one Euler step of size DT.\n */\nfunction step() {\n  const dx = SIGMA * (y - x);\n  const dy = x * (RHO - z) - y;\n  const dz = x * y - BETA * z;\n  x += dx * DT;\n  y += dy * DT;\n  z += dz * DT;\n}\n\n//------------------------------------------------------------------------------\n// Benchmark reporting\n//------------------------------------------------------------------------------\n\n/**\n * @brief Reports the measured step rate every STATS_EVERY steps, so the control\n *        loop's speed and steadiness are observable from the dashboard.\n */\nfunction reportRate() {\n  if (STATS_EVERY <= 0 || (stepCount - lastReportStep) < STATS_EVERY)\n    return;\n\n  const now = Date.now();\n  const elapsed = now - lastReportMs;\n  if (elapsed > 0) {\n    const rate = Math.round((stepCount - lastReportStep) * 1000 / elapsed);\n    notifyInfo(\"Lorenz Attractor\", rate + \" steps/s\");\n  }\n\n  lastReportStep = stepCount;\n  lastReportMs = now;\n}\n\n//------------------------------------------------------------------------------\n// Lifecycle\n//------------------------------------------------------------------------------\n\n/**\n * @brief Seeds the clock and announces that the simulation runs entirely from\n *        the control loop.\n */\nfunction setup() {\n  lastReportMs = Date.now();\n  notifyInfo(\"Lorenz Attractor\", \"Simulating from the control loop; no external generator.\");\n}\n\n/**\n * @brief Advances the simulation, publishes x/y/z to the data table, and ticks\n *        the dashboard so the virtual datasets render the fresh trajectory.\n */\nfunction loop() {\n  for (let i = 0; i < STEPS_PER_TICK; ++i)\n    step();\n\n  stepCount += STEPS_PER_TICK;\n  tableSet(TABLE, \"x\", x);\n  tableSet(TABLE, \"y\", y);\n  tableSet(TABLE, \"z\", z);\n  dashboardTick();\n  reportRate();\n}\n","frozen":false,"groups":[{"datasets":[{"datasetId":0,"displayFormat":"0d","displayTickCount":5,"fft":false,"fftMax":20,"fftMin":-20,"fftSamples":256,"fftSamplingRate":100,"fftWindow":5,"graph":true,"groupId":0,"index":1,"led":false,"ledHigh":1,"log":false,"numericValue":0,"plotMax":20,"plotMin":-20,"title":"X","transformCode":"function transform(value)\n  local v = tableGet(\"Lorenz\", \"x\")\n  if v == nil then\n    return 0\n  end\n  return v\nend\n","transformLanguage":1,"uniqueId":0,"units":"","value":"","virtual":true,"widget":"","widgetMax":20,"widgetMin":-20,"xAxis":1},{"datasetId":1,"displayFormat":"0d","displayTickCount":5,"fft":false,"fftMax":30,"fftMin":-30,"fftSamples":256,"fftSamplingRate":100,"fftWindow":5,"graph":true,"groupId":0,"index":2,"led":false,"ledHigh":1,"log":false,"numericValue":0,"plotMax":30,"plotMin":-30,"title":"Y","transformCode":"function transform(value)\n  local v = tableGet(\"Lorenz\", \"y\")\n  if v == nil then\n    return 0\n  end\n  return v\nend\n","transformLanguage":1,"uniqueId":1,"units":"","value":"","virtual":true,"widget":"","widgetMax":30,"widgetMin":-30,"xAxis":2},{"datasetId":2,"displayFormat":"0d","displayTickCount":5,"fft":false,"fftMax":50,"fftMin":0,"fftSamples":256,"fftSamplingRate":100,"fftWindow":5,"graph":true,"groupId":0,"index":3,"led":false,"ledHigh":1,"log":false,"numericValue":0,"plotMax":50,"plotMin":0,"title":"Z","transformCode":"function transform(value)\n  local v = tableGet(\"Lorenz\", \"z\")\n  if v == nil then\n    return 0\n  end\n  return v\nend\n","transformLanguage":1,"uniqueId":2,"units":"","value":"","virtual":true,"widget":"","widgetMax":50,"widgetMin":0,"xAxis":0}],"title":"2D Visualization","uniqueId":10003,"widget":"multiplot"},{"datasets":[{"datasetId":0,"displayFormat":"0d","displayTickCount":5,"fft":false,"fftMax":20,"fftMin":-20,"fftSamples":256,"fftSamplingRate":100,"fftWindow":5,"graph":false,"groupId":1,"index":1,"led":false,"ledHigh":1,"log":false,"numericValue":0,"plotMax":20,"plotMin":-20,"title":"X","transformCode":"function transform(value)\n  local v = tableGet(\"Lorenz\", \"x\")\n  if v == nil then\n    return 0\n  end\n  return v\nend\n","transformLanguage":1,"uniqueId":10000,"units":"","value":"","virtual":true,"widget":"x","widgetMax":20,"widgetMin":-20,"xAxis":2},{"datasetId":1,"displayFormat":"0d","displayTickCount":5,"fft":false,"fftMax":30,"fftMin":-30,"fftSamples":256,"fftSamplingRate":100,"fftWindow":5,"graph":false,"groupId":1,"index":2,"led":false,"ledHigh":1,"log":false,"numericValue":0,"plotMax":30,"plotMin":-30,"title":"Y","transformCode":"function transform(value)\n  local v = tableGet(\"Lorenz\", \"y\")\n  if v == nil then\n    return 0\n  end\n  return v\nend\n","transformLanguage":1,"uniqueId":10001,"units":"","value":"","virtual":true,"widget":"y","widgetMax":30,"widgetMin":-30,"xAxis":3},{"datasetId":2,"displayFormat":"0d","displayTickCount":5,"fft":false,"fftMax":50,"fftMin":0,"fftSamples":256,"fftSamplingRate":100,"fftWindow":5,"graph":false,"groupId":1,"index":3,"led":false,"ledHigh":1,"log":false,"numericValue":0,"plotMax":50,"plotMin":0,"title":"Z","transformCode":"function transform(value)\n  local v = tableGet(\"Lorenz\", \"z\")\n  if v == nil then\n    return 0\n  end\n  return v\nend\n","transformLanguage":1,"uniqueId":10002,"units":"","value":"","virtual":true,"widget":"z","widgetMax":50,"widgetMin":0,"xAxis":1}],"title":"3D Visua