    "changeDrivenTransforms": false,
    "controlScriptCode": "/**\n * Siemens S7 PLC Simulator - Control Loop\n *\n * Launches the bundled Python simulator (s7_plc_simulator.py) automatically just before the\n * connection opens (via onConnect), so the example works without running anything by hand. The\n * helper process is stopped by Serial Studio when the device is disconnected, when the project\n * changes, or when the app quits.\n *\n * The interpreter is resolved cross-platform: \"python3\" is tried first (Linux/macOS), falling\n * back to \"python\" (typical on Windows).\n *\n * The S7 ISO-TSAP port is fixed at 102 by the protocol, and ports below 1024 are privileged on\n * macOS and Linux. If the auto-started helper cannot bind port 102, start it once with elevated\n * privileges (sudo python3 s7_plc_simulator.py) before pressing Connect.\n */\n\nvar helperPid = -1;\n\nfunction startHelper() {\n  var dir = system.projectDir();\n  if (!dir.ok)\n    return;\n\n  var script = dir.result.directory + \"/s7_plc_simulator.py\";\n\n  var r = system.exec(\"python3\", { args: [\"-u\", script, \"--host\", \"127.0.0.1\", \"--port\", \"102\"], workingDir: dir.result.directory });\n  if (!r.ok)\n    r = system.exec(\"python\", { args: [\"-u\", script, \"--host\", \"127.0.0.1\", \"--port\", \"102\"], workingDir: dir.result.directory });\n\n  if (r.ok)\n    helperPid = r.result.processId;\n}\n\nfunction onConnect() {\n  startHelper();\n}\n\nfunction setup() {}\n\nfunction loop() {\n  delay(1000);\n}\n",
    "frozen": true,
